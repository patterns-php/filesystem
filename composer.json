{
    "name": "patterns/filesystem",
    "description": "Filesystem pattern - the seven operations every storage backend can honour, plus an opt-in capability for the ones that can describe a path.",
    "type": "library",
    "keywords": [
        "filesystem",
        "storage",
        "port",
        "adapter",
        "capability",
        "pattern",
        "disk",
        "s3"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "patterns/value-object": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Patterns\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Patterns\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
